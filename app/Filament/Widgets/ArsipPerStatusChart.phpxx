<?php

namespace App\Filament\Widgets;

use App\Enums\ArsipStatus;
use App\Models\Arsip;
use Filament\Widgets\ChartWidget;

/**
 * Chart batang jumlah arsip per Status (Draft/Input/Terverifikasi).
 * Urutan & warna kategori TETAP (tidak ikut-ikutan urutan jumlah data) --
 * biar warna selalu konsisten mewakili status yang sama tiap kali dibuka.
 */
class ArsipPerStatusChart extends ChartWidget
{
    protected static ?int $sort = 2;

    protected ?string $heading = 'Arsip per Status';

    protected function getType(): string
    {
        return 'bar';
    }

    protected function getData(): array
    {
        $user = auth()->user();

        $counts = Arsip::query()->milikUser($user)
            ->selectRaw('status, count(*) as total')
            ->groupBy('status')
            ->pluck('total', 'status');

        $cases = ArsipStatus::cases();

        return [
            'datasets' => [
                [
                    'label' => 'Jumlah Arsip',
                    'data' => collect($cases)->map(fn (ArsipStatus $case) => $counts[$case->value] ?? 0)->all(),
                    // Palet kategorikal tetap: blue/orange/aqua -- urutan
                    // ini fixed, bukan hasil sort dari data.
                    'backgroundColor' => ['#2a78d6', '#eb6834', '#1baf7a'],
                ],
            ],
            'labels' => collect($cases)->map(fn (ArsipStatus $case) => $case->getLabel())->all(),
        ];
    }

    protected function getOptions(): array
    {
        return [
            'plugins' => [
                'legend' => ['display' => false],
            ],
            'scales' => [
                'y' => ['beginAtZero' => true, 'ticks' => ['stepSize' => 1]],
            ],
        ];
    }
}
